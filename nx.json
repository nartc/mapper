{
    "extends": "nx/presets/core.json",
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "plugins": [
        {
            "plugin": "@nx/js/typescript"
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            },
            "include": [
                "packages/classes/mapped-types/**/*",
                "packages/classes/**/*",
                "packages/classes/transformer-plugin/**/*",
                "packages/core/**/*",
                "packages/integration-test/**/*",
                "packages/mikro/**/*",
                "packages/nestjs/**/*",
                "packages/pojos/**/*",
                "packages/sequelize/**/*"
            ]
        }
    ],
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "shared"],
        "prod": ["!{projectRoot}/**/*.spec.ts"],
        "shared": ["{workspaceRoot}/.github/workflows/ci.yml"]
    },
    "targetDefaults": {
        "build": {
            "cache": true
        },
        "package": {
            "cache": true,
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/tools/scripts/build-packages.mjs"
            ]
        },
        "package-lib": {
            "cache": true
        },
        "test": {
            "inputs": ["default", "^prod"],
            "cache": true
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "syncGenerators": ["@nx/js:typescript-sync"],
            "options": {
                "command": "tsc --build --emitDeclarationOnly"
            }
        }
    },
    "release": {
        "projects": [
            "core",
            "classes",
            "pojos",
            "nestjs",
            "mikro",
            "sequelize"
        ],
        "version": {
            "preVersionCommand": "pnpm package",
            "currentVersionResolver": "git-tag",
            "preserveLocalDependencyProtocols": false,
            "preserveMatchingDependencyRanges": false,
            "manifestRootsToUpdate": ["dist/packages/{projectName}"]
        },
        "conventionalCommits": {
            "types": {
                "refactor": {
                    "changelog": true,
                    "semverBump": "patch"
                },
                "perf": {
                    "changelog": true,
                    "semverBump": "patch"
                }
            }
        },
        "changelog": {
            "workspaceChangelog": {
                "createRelease": "github"
            }
        }
    },
    "pluginsConfig": {
        "@nx/js": {
            "analyzeSourceFiles": true
        }
    },
    "defaultBase": "main",
    "analytics": false,
    "nxCloudId": "6a3e997e7427195a38f6bdbc",
    "bust": "3",
    "affected": {
        "legacy": true
    }
}
